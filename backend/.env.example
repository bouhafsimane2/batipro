# Port de l'API (le front appelle http://127.0.0.1:8000 par défaut)
PORT=8000
# URL publique de l'API, utilisée pour construire les URLs absolues des images
PUBLIC_URL=http://127.0.0.1:8000
# Origines autorisées (CORS + Socket.IO), séparées par des virgules
CLIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Chemin du fichier SQLite
DB_FILE=./data/batipro.sqlite
