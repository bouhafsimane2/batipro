{
  "name": "batipro-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST + messagerie temps réel (Socket.IO) pour Batipro",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "seed": "node --disable-warning=ExperimentalWarning src/db/seed.js",
    "reset-db": "node --disable-warning=ExperimentalWarning src/db/seed.js --reset",
    "start:prod": "npm run seed && npm start"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "multer": "^2.4.0",
    "socket.io": "^4.8.4"
  }
}
